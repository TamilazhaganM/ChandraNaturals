# ==============================================================================
# CHANDRA NATURALS - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file to Git!

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Connection String (MongoDB Atlas or local instance)
# Example: mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/chandra_naturals?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/chandra_naturals

# JWT Authentication Secrets
# Generate random 64+ char strings (e.g., openssl rand -base64 48)
JWT_SECRET=replace_with_a_very_strong_random_jwt_access_secret_chandra_naturals
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_very_strong_random_jwt_refresh_secret_chandra_naturals
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay Payment Gateway Credentials (Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_1DP5mmOlF5G5ag
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_razorpay_webhook_secret

# MSG91 SMS & Flow Service (For transactional OTP delivery in India)
# Optional in development; when empty, OTP is logged safely to the console for testing
MSG91_AUTH_KEY=
MSG91_SENDER_ID=CHNDRA
MSG91_TEMPLATE_ID=
MSG91_OTP_EXPIRY_MINUTES=10

# MSG91 Email Service (For Email OTP verification)
# Calls https://control.msg91.com/api/v5/email/send
# Template variables sent: otp, OTP, code, name, company_name, purpose
MSG91_EMAIL_TEMPLATE_ID=
MSG91_EMAIL_DOMAIN=
MSG91_EMAIL_FROM_EMAIL=hello@chandranaturals.com
MSG91_EMAIL_FROM_NAME="Chandra Naturals"

# Email Delivery Configuration (Nodemailer / SMTP provider e.g., Gmail, Resend, Brevo, Mailgun)
# Optional in development; when empty, emails are logged safely to the console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Chandra Naturals <hello@chandranaturals.com>"

# Default Super Admin Seed Credentials
ADMIN_NAME="Chandra Admin"
ADMIN_EMAIL=admin@chandranaturals.com
ADMIN_PHONE=9876500000
ADMIN_PASSWORD=AdminPass@Chandra2026
